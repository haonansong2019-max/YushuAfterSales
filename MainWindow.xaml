<Window x:Class="YushuAfterSales.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="钰叔售后" MinWidth="760" MinHeight="520" Width="1120" Height="720"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextBrush}" FontFamily="{DynamicResource FontPrimary}"
        PreviewKeyDown="Window_PreviewKeyDown">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="216"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border x:Name="Sidebar" Grid.Column="0" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="*"/><RowDefinition Height="46"/></Grid.RowDefinitions>
        <Button x:Name="BrandButton" Grid.Row="0" Style="{DynamicResource NavButtonStyle}" Margin="12,4,12,4" Padding="0" HorizontalContentAlignment="Left" Click="BrandButton_Click" ToolTip="回到概览" AutomationProperties.Name="钰叔售后概览">
          <StackPanel Orientation="Horizontal"><Border Width="24" Height="24" CornerRadius="5" Background="{DynamicResource AccentBrush}" Margin="0,0,8,0"><TextBlock Text="Y" Foreground="{DynamicResource ButtonTextBrush}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock x:Name="BrandButtonText" Text="钰叔售后" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></StackPanel>
        </Button>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="8">
          <StackPanel>
            <TextBlock x:Name="TeamAppsLabel" Text="团队应用" Style="{DynamicResource Typography.Caption}" Foreground="{DynamicResource TextFaintBrush}" Margin="8,4,8,8"/>
            <Button Tag="overview" Style="{DynamicResource NavButtonStyle}" Click="NavigationButton_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="⌂" Width="24"/><TextBlock Text="全面扫描"/></StackPanel></Button>
            <Button Tag="runtime" Style="{DynamicResource NavButtonStyle}" Click="NavigationButton_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="▣" Width="24"/><TextBlock Text="运行库修复"/></StackPanel></Button>
            <Button Tag="directx" Style="{DynamicResource NavButtonStyle}" Click="NavigationButton_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="◇" Width="24"/><TextBlock Text="DirectX 修复"/></StackPanel></Button>
            <Button Tag="dll" Style="{DynamicResource NavButtonStyle}" Click="NavigationButton_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="▤" Width="24"/><TextBlock Text="DLL 修复"/></StackPanel></Button>
            <Button Tag="system" Style="{DynamicResource NavButtonStyle}" Click="NavigationButton_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="⚙" Width="24"/><TextBlock Text="系统修复"/></StackPanel></Button>
            <Button Tag="components" Style="{DynamicResource NavButtonStyle}" Click="NavigationButton_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="✣" Width="24"/><TextBlock Text="游戏组件"/></StackPanel></Button>
            <Button Tag="reports" Style="{DynamicResource NavButtonStyle}" Click="NavigationButton_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="≡" Width="24"/><TextBlock Text="诊断报告"/></StackPanel></Button>
            <Separator Margin="8,16,8,12" Background="{DynamicResource LineBrush}"/>
            <TextBlock x:Name="LicensedAppsLabel" Text="授权应用" Style="{DynamicResource Typography.Caption}" Foreground="{DynamicResource TextFaintBrush}" Margin="8,0,8,8"/>
            <Button Tag="settings" Style="{DynamicResource NavButtonStyle}" Click="NavigationButton_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="⚙" Width="24"/><TextBlock Text="设置"/></StackPanel></Button>
            <Button Tag="license" Style="{DynamicResource NavButtonStyle}" Click="NavigationButton_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="◇" Width="24"/><TextBlock Text="授权状态"/></StackPanel></Button>
            <Button Tag="updates" Style="{DynamicResource NavButtonStyle}" Click="NavigationButton_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="↻" Width="24"/><TextBlock Text="在线升级"/></StackPanel></Button>
          </StackPanel>
        </ScrollViewer>
        <Grid Grid.Row="2" Margin="8,4,8,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions><Button x:Name="LanguageButton" Style="{DynamicResource IconButtonStyle}" Content="EN" Click="ToggleLanguageButton_Click" ToolTip="切换显示语言" AutomationProperties.Name="切换显示语言"/><Button x:Name="SidebarCollapseButton" Grid.Column="1" Style="{DynamicResource IconButtonStyle}" Content="◀" Click="ToggleSidebarButton_Click" ToolTip="收起导航栏" AutomationProperties.Name="收起导航栏"/><Button Grid.Column="2" Style="{DynamicResource IconButtonStyle}" Content="⋯" Click="AppearanceButton_Click" ToolTip="主题和外观" AutomationProperties.Name="主题和外观"/></Grid>
      </Grid>
    </Border>
    <Grid Grid.Column="1">
      <Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1"><Grid Margin="12,0,8,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock x:Name="ToolbarTitle" Text="全面扫描" Style="{DynamicResource Typography.ModuleTitle}"/><TextBlock Text="  ·  " Foreground="{DynamicResource TextFaintBrush}"/><TextBlock x:Name="ToolbarStatus" Text="准备就绪" Style="{DynamicResource Typography.Caption}" Foreground="{DynamicResource TextMutedBrush}"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="RefreshButton" Style="{DynamicResource IconButtonStyle}" Content="↻" Click="RefreshButton_Click" ToolTip="刷新当前状态" AutomationProperties.Name="刷新当前状态"/><Button x:Name="CloseModuleButton" Style="{DynamicResource IconButtonStyle}" Content="×" Click="CloseModuleButton_Click" ToolTip="关闭当前模块" AutomationProperties.Name="关闭当前模块"/></StackPanel></Grid></Border>
      <Grid Grid.Row="1" x:Name="PageHost" Background="{DynamicResource BackgroundBrush}">
        <Grid x:Name="OverviewPage" Visibility="Visible" Margin="24">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <StackPanel Grid.Row="0" MaxWidth="680" HorizontalAlignment="Center" Margin="0,36,0,16">
            <StackPanel Orientation="Horizontal"><Border Width="40" Height="40" CornerRadius="8" Background="{DynamicResource AccentBrush}" Margin="0,0,12,0"><TextBlock Text="✓" Foreground="{DynamicResource ButtonTextBrush}" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel VerticalAlignment="Center"><TextBlock x:Name="OverviewTitle" Text="全面扫描" Style="{DynamicResource Typography.SectionTitle}"/><TextBlock x:Name="OverviewDescription" Text="检查本机已安装的运行库、系统组件与常见依赖" Style="{DynamicResource Typography.Body}" Foreground="{DynamicResource TextMutedBrush}"/></StackPanel></StackPanel>
            <TextBlock x:Name="OverviewSafetyNote" Text="扫描默认只读。完成后可复核每一项证据；任何安装或系统级操作均需单独确认。" TextWrapping="Wrap" Style="{DynamicResource Typography.Body}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,16,0,12"/>
            <StackPanel Orientation="Horizontal"><Button x:Name="ScanButton" Content="开始扫描  →" Style="{DynamicResource PrimaryButtonStyle}" Click="ScanButton_Click"/><Button x:Name="ErrorDiagnosisButton" Content="错误码诊断" Style="{DynamicResource SecondaryButtonStyle}" Margin="8,0,0,0" Click="ErrorDiagnosisButton_Click"/></StackPanel>
            <TextBlock x:Name="OverviewStatus" Text="尚未开始扫描" Style="{DynamicResource Typography.Secondary}" Foreground="{DynamicResource TextFaintBrush}" Margin="0,12,0,0"/>
            <TextBlock x:Name="OverviewEvidence" TextWrapping="Wrap" Style="{DynamicResource Typography.Secondary}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0"/>
          </StackPanel>
          <Grid Grid.Row="1" MaxWidth="920" HorizontalAlignment="Center">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock x:Name="OverviewHeaderEvidence" Text="组件 / 证据" Style="{DynamicResource Typography.Secondary}"/><TextBlock x:Name="OverviewHeaderVersion" Grid.Column="1" Text="版本" Style="{DynamicResource Typography.Secondary}"/><TextBlock x:Name="OverviewHeaderStatus" Grid.Column="2" Text="状态" Style="{DynamicResource Typography.Secondary}"/><TextBlock x:Name="OverviewHeaderCompatibility" Grid.Column="3" Text="兼容性" Style="{DynamicResource Typography.Secondary}"/><TextBlock x:Name="OverviewHeaderSource" Grid.Column="4" Text="来源" Style="{DynamicResource Typography.Secondary}"/></Grid>
            <DataGrid x:Name="FindingsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="None" GridLinesVisibility="Horizontal" Background="{DynamicResource BackgroundBrush}" RowBackground="{DynamicResource SurfaceBrush}" AlternatingRowBackground="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource LineBrush}" SelectionMode="Single" SelectionUnit="FullRow" MinRowHeight="38">
              <DataGrid.Columns><DataGridTextColumn Binding="{Binding DisplayName}" Width="2*"/><DataGridTextColumn Binding="{Binding DetectedVersion}" Width="*"/><DataGridTextColumn Binding="{Binding StatusLabel}" Width="*"/><DataGridTextColumn Binding="{Binding Compatibility}" Width="*"/><DataGridTextColumn Binding="{Binding SourceLabel}" Width="*"/></DataGrid.Columns>
            </DataGrid>
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0"><Button x:Name="OpenOfficialButton" Content="打开官方来源" Style="{DynamicResource SecondaryButtonStyle}" Click="OpenOfficialButton_Click"/><Button x:Name="ExportReportButton" Content="导出诊断 ZIP" Margin="8,0,0,0" Style="{DynamicResource SecondaryButtonStyle}" Click="ExportReportButton_Click"/></StackPanel>
          </Grid>
        </Grid>
        <Grid x:Name="ModulePage" Visibility="Collapsed" Margin="24">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel Grid.Row="0" Margin="0,0,0,16"><TextBlock x:Name="PlaceholderTitle" Text="运行库修复" Style="{DynamicResource Typography.SectionTitle}"/><TextBlock x:Name="PlaceholderDescription" TextWrapping="Wrap" Style="{DynamicResource Typography.Secondary}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0"/><Grid x:Name="AuthorizationActivationPanel" Visibility="Collapsed" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><PasswordBox x:Name="AuthorizationCodeBox" Grid.Column="0" MinHeight="32" Padding="8,4" FontFamily="{DynamicResource FontPrimary}" FontSize="14" ToolTip="输入授权卡密" AutomationProperties.Name="授权卡密"/><Button x:Name="AuthorizationActivateButton" Grid.Column="1" Content="激活授权" Margin="8,0,0,0" Style="{DynamicResource PrimaryButtonStyle}" Click="ActivateAuthorizationButton_Click"/></Grid></StackPanel>
          <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12"><TextBlock x:Name="PlaceholderStatus" Text="需要先执行只读扫描。" TextWrapping="Wrap" Style="{DynamicResource Typography.Secondary}" Foreground="{DynamicResource TextMutedBrush}"/></Border>
          <DataGrid x:Name="ModuleGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="False" CanUserAddRows="False" CanUserDeleteRows="False" GridLinesVisibility="Horizontal" Background="{DynamicResource BackgroundBrush}" RowBackground="{DynamicResource SurfaceBrush}" AlternatingRowBackground="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource LineBrush}" SelectionMode="Single" SelectionUnit="FullRow" MinRowHeight="38">
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="选择" Width="52">
                <DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsRepairCandidate}" HorizontalAlignment="Center" VerticalAlignment="Center" Click="SelectionCheckBox_Click" AutomationProperties.Name="选择修复项目"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="组件" Binding="{Binding DisplayName}" Width="2*"/>
              <DataGridTextColumn Header="架构" Binding="{Binding Architecture}" Width="0.7*"/>
              <DataGridTextColumn Header="当前版本" Binding="{Binding DetectedVersion}" Width="*"/>
              <DataGridTextColumn Header="目标版本" Binding="{Binding ExpectedVersion}" Width="*"/>
              <DataGridTextColumn Header="状态" Binding="{Binding StatusLabel}" Width="*"/>
              <DataGridTextColumn Header="证据 ID" Binding="{Binding EvidenceId}" Width="1.2*"/>
            </DataGrid.Columns>
          </DataGrid>
          <StackPanel Grid.Row="3" Margin="0,12,0,0"><TextBlock x:Name="ModuleEvidence" TextWrapping="Wrap" Style="{DynamicResource Typography.Caption}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,8"/><TextBlock x:Name="SelectionSummary" Text="可选择待复核项目；修复前会显示预览。" TextWrapping="Wrap" Style="{DynamicResource Typography.Secondary}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,8"/><ComboBox x:Name="SystemActionCombo" Width="360" HorizontalAlignment="Left" Margin="0,0,0,8" Visibility="Collapsed" FontFamily="{DynamicResource FontPrimary}" FontSize="14"><ComboBoxItem Content="SFC /scannow" IsSelected="True"/><ComboBoxItem Content="DISM /RestoreHealth"/><ComboBoxItem Content="启用 .NET Framework 3.5"/></ComboBox><StackPanel Orientation="Horizontal"><Button x:Name="ModulePrimaryButton" Content="执行所选系统修复" Style="{DynamicResource PrimaryButtonStyle}" Click="ModulePrimaryButton_Click"/><Button x:Name="ModuleSelectButton" Content="全选待复核" Margin="8,0,0,0" Style="{DynamicResource SecondaryButtonStyle}" Click="ModuleSelectButton_Click"/><Button x:Name="OpenSourceListButton" Content="打开选中项官方来源" Margin="8,0,0,0" Style="{DynamicResource SecondaryButtonStyle}" Click="OpenOfficialButton_Click"/><Button x:Name="ExportModuleReportButton" Content="导出诊断 ZIP" Margin="8,0,0,0" Style="{DynamicResource SecondaryButtonStyle}" Click="ExportReportButton_Click"/><Button x:Name="OpenReportFolderButton" Content="打开报告目录" Margin="8,0,0,0" Style="{DynamicResource SecondaryButtonStyle}" Click="OpenReportFolderButton_Click"/></StackPanel></StackPanel>
        </Grid>
      </Grid>
    </Grid>
    <Border x:Name="ThemeMenu" Grid.ColumnSpan="2" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12" Padding="12" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Visibility="Collapsed"><StackPanel><TextBlock x:Name="ThemeMenuTitle" Text="主题" Style="{DynamicResource Typography.ItemTitle}" Margin="0,0,0,8"/><Button Content="CSYUSHU Brown" Tag="brown" Style="{DynamicResource SecondaryButtonStyle}" Click="ThemeButton_Click"/><Button Content="Windows Light" Tag="light" Style="{DynamicResource SecondaryButtonStyle}" Margin="0,4,0,0" Click="ThemeButton_Click"/><Button Content="Windows Dark" Tag="dark" Style="{DynamicResource SecondaryButtonStyle}" Margin="0,4,0,0" Click="ThemeButton_Click"/><Button Content="跟随系统" Tag="system" Style="{DynamicResource SecondaryButtonStyle}" Margin="0,4,0,0" Click="ThemeButton_Click"/></StackPanel></Border>
    <Button x:Name="SidebarExpandButton" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8" Width="24" Height="24" Visibility="Collapsed" Style="{DynamicResource IconButtonStyle}" Content="▶" Click="ToggleSidebarButton_Click" ToolTip="展开导航栏" AutomationProperties.Name="展开导航栏"/>
  </Grid>
</Window>
